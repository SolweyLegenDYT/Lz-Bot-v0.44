# ─────────────────────────────────────────────
#  Lz Bot — Variables de Entorno
#  Copia este archivo como .env y rellena tus valores
# ─────────────────────────────────────────────

# Nombre del bot (aparece en menús y mensajes)
BOT_NAME=LZ BOT

# Prefijo de comandos (por defecto: .)
PREFIX=.

# Idioma del bot (es = español)
LANGUAGE=es

# Número del propietario/desarrollador (sin + ni espacios)
# Ejemplo: 31629049445
OWNER_NUMBER=

# Nombre del propietario
OWNER_NAME= LzSunshNe

# ── APIs de IA (opcionales) ───────────────────
# OpenAI (para .ai, .chat, .gpt, .ask, .code, .translate, .summarize, .imageprompt)
OPENAI_KEY=

# Google Gemini (alternativa a OpenAI)
GEMINI_KEY=

# ── Stickers ──────────────────────────────────
STICKER_AUTHOR=Lz Bot
STICKER_PACK=Lz🐿️ᴀͨʀͧᴅᷞɪͦʟᷠʟᷧᴀ
